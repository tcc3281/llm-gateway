# ==============================================================
# LLM Gateway — System Configuration only (.env)
#
# Upstream provider API keys (OpenAI / Anthropic / Gemini) are NOT
# configured here. They are managed at runtime and stored in the
# provider_keys table via:
#     llmgw provider set --provider openai --api-key sk-...
#     (or POST /admin/providers on the admin API)
# ==============================================================

# Server Configuration
PORT=8080
ADMIN_PORT=8081
ENV=development

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=llm_user
DB_PASSWORD=llm_password
DB_NAME=llm_gateway
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=redis:6379
REDIS_PASSWORD=

# Admin Auth Secret (used to protect the Admin API on port 8081)
ADMIN_API_KEY=sk-admin-secret-key-change-me

# Optional: Restrict admin access (port 8081) to specific IPs or CIDR blocks (comma-separated).
# If empty, any IP can access the Admin API (provided they have the ADMIN_API_KEY).
# Example: ADMIN_ALLOWED_IPS=127.0.0.1,192.168.1.0/24
ADMIN_ALLOWED_IPS=

# Optional: encrypt provider keys at rest in PostgreSQL.
# Set a long random passphrase. If empty, provider keys are stored
# in plaintext (development only). Changing this later keeps existing
# plaintext entries readable but re-saving a key re-encrypts it.
# PROVIDER_MASTER_KEY=change-me-to-a-long-random-passphrase

# LLM Exact-Match Response Caching (global fallback in seconds; default 3600 = 1 hour)
# Can be overridden per API key via admin API (-1 = off, 0 = global, >0 = custom)
CACHE_RESPONSE_TTL_SECONDS=3600

# OpenTelemetry Distributed Tracing & Metrics
# OTEL_EXPORTER: "otlp" (default) | "stdout" (dev) | "none" (disabled)
OTEL_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Observability & Content Capture Policy
# "none" = never attach prompt/completion text to spans (default, production-safe)
# "event_only" = attach PII-redacted prompt & completion events to OTel spans
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=none

# Service Level Objectives (SLOs) for Streaming Goodput
SLO_MAX_TTFT_MS=500
SLO_MAX_TBT_MS=250

# Agent Runaway Loop Prevention Threshold (tool calls per conversation/request)
AGENT_MAX_TOOL_CALLS=10
