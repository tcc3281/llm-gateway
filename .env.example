# ==============================================================
# LLM Gateway — System Configuration only (.env)
#
# Upstream provider API keys (OpenAI / Anthropic / Gemini) are NOT
# configured here. They are managed at runtime and stored in the
# provider_keys table via:
#     llmgw provider set --provider openai --api-key sk-...
#     (or POST /admin/providers on the admin API)
# ==============================================================

# Server Configuration
PORT=8080
ADMIN_PORT=8081
ENV=development

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=llm_user
DB_PASSWORD=llm_password
DB_NAME=llm_gateway
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=redis:6379
REDIS_PASSWORD=

# Admin Auth Secret (used to protect the Admin API on port 8081)
ADMIN_API_KEY=sk-admin-secret-key-change-me

# Optional: Restrict admin access (port 8081) to specific IPs or CIDR blocks (comma-separated).
# If empty, any IP can access the Admin API (provided they have the ADMIN_API_KEY).
# Example: ADMIN_ALLOWED_IPS=127.0.0.1,192.168.1.0/24
ADMIN_ALLOWED_IPS=

# Optional: encrypt provider keys at rest in PostgreSQL.
# Set a long random passphrase. If empty, provider keys are stored
# in plaintext (development only). Changing this later keeps existing
# plaintext entries readable but re-saving a key re-encrypts it.
# PROVIDER_MASTER_KEY=change-me-to-a-long-random-passphrase
