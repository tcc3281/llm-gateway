  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "SLO & Reliability (Goodput, TTFT, TBT)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "title": "Streaming Goodput Ratio",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(llmgw_goodput_requests_total[5m])) / (sum(rate(llmgw_goodput_requests_total[5m])) + sum(rate(llmgw_slo_violation_total[5m])))",
          "legendFormat": "Goodput Rate"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 1 },
      "id": 2,
      "title": "Time to First Token (TTFT) p95 / p99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(gen_ai_client_time_to_first_token_bucket[5m])) by (le))",
          "legendFormat": "p95 TTFT"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(gen_ai_client_time_to_first_token_bucket[5m])) by (le))",
          "legendFormat": "p99 TTFT"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 1 },
      "id": 3,
      "title": "Time Between Tokens (TBT) p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(gen_ai_client_time_between_tokens_bucket[5m])) by (le))",
          "legendFormat": "p95 TBT"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "Tokens & Financials",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "id": 4,
      "title": "Estimated Cost Total (USD)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(llmgw_cost_usd_total)",
          "legendFormat": "Total Cost"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "tokens/s", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 8 },
      "id": 5,
      "title": "Token Consumption by Type",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(gen_ai_client_token_usage_total[5m])) by (gen_ai_token_type)",
          "legendFormat": "{{gen_ai_token_type}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Agent Safety & Cache Operations",
