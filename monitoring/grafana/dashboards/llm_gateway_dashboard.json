    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 15 },
      "id": 6,
      "title": "Agent Runaway Loops Detected",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(llmgw_agent_runaway_loops_total[5m]))",
          "legendFormat": "Loops / sec"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 15 },
      "id": 7,
      "title": "Cache Hit Ratio",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(llmgw_cache_requests_total{llmgw_cache_status=\"hit\"}[5m])) / sum(rate(llmgw_cache_requests_total[5m]))",
          "legendFormat": "Hit Rate"
        }
