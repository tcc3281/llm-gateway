      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 15 },
      "id": 8,
      "title": "Provider Fallbacks Triggered",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(llmgw_fallback_requests_total[5m])) by (llmgw_primary_provider, llmgw_fallback_provider)",
          "legendFormat": "{{llmgw_primary_provider}} -> {{llmgw_fallback_provider}}"
        }
      ]
    }
  ],
